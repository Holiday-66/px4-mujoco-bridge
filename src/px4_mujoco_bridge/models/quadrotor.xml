      <geom name="nose" type="box" pos="0.09 0 0.005" size="0.018 0.03 0.018" rgba="1 0.35 0.1 1"/>
      <geom name="prop_1" type="cylinder" pos="0.2 -0.2 0.015" size="0.085 0.003" contype="0" conaffinity="0" rgba="0.2 0.65 0.95 0.65"/>
      <geom name="prop_2" type="cylinder" pos="-0.2 0.2 0.015" size="0.085 0.003" contype="0" conaffinity="0" rgba="0.2 0.65 0.95 0.65"/>
      <geom name="prop_3" type="cylinder" pos="0.2 0.2 0.015" size="0.085 0.003" contype="0" conaffinity="0" rgba="0.9 0.55 0.2 0.65"/>
      <geom name="prop_4" type="cylinder" pos="-0.2 -0.2 0.015" size="0.085 0.003" contype="0" conaffinity="0" rgba="0.9 0.55 0.2 0.65"/>
