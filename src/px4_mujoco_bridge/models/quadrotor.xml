  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.20 0.23 0.26" rgb2="0.30 0.33 0.37" width="512" height="512"/>
    <material name="floor" texture="grid" texrepeat="8 8" reflectance="0.05"/>
  </asset>
  <default>
    <geom mass="0" friction="0.8 0.02 0.002"/>
    <site size="0.01" rgba="1 0.6 0.1 1"/>
    <motor ctrllimited="true" ctrlrange="0 10"/>
