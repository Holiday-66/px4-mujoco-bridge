      <geom type="sphere" pos="-0.08 0.05 -0.07" size="0.015"/>
      <geom type="sphere" pos="-0.08 -0.05 -0.07" size="0.015"/>
      <site name="imu" pos="0 0 0"/>
      <site name="rotor_1" pos="0.2 -0.2 0"/>
      <site name="rotor_2" pos="-0.2 0.2 0"/>
      <site name="rotor_3" pos="0.2 0.2 0"/>
      <site name="rotor_4" pos="-0.2 -0.2 0"/>
    </body>
  </worldbody>
  <actuator>
    <motor name="thrust_1" site="rotor_1" gear="0 0 1 0 0 -0.02"/>
    <motor name="thrust_2" site="rotor_2" gear="0 0 1 0 0 -0.02"/>
    <motor name="thrust_3" site="rotor_3" gear="0 0 1 0 0 0.02"/>
    <motor name="thrust_4" site="rotor_4" gear="0 0 1 0 0 0.02"/>
  </actuator>
  <sensor>
    <accelerometer name="imu_accelerometer" site="imu"/>
    <gyro name="imu_gyro" site="imu"/>
  </sensor>
</mujoco>
